{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "rootDir": "./src",
        "module": "esnext",
        "target": "ES2022",
        "moduleResolution": "bundler",
        "allowJs": false,
        "forceConsistentCasingInFileNames": true,
        "noImplicitReturns": true,
        "strict": true,
        "types": ["vitest"]
    }
}
